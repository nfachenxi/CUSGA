      m_Calls: []
  m_text: "\n  \u672C\u6E38\u620F\u7531\u7B2C\u56DB\u9886\u57DF\u521B\u6E38\u793E\u5236\u4F5C\uFF0C\u4E3A2025CUSGA\u53C2\u8D5B\u4F5C\u54C1\u3002\n\n 
    \u672C\u6E38\u620F\u4F7F\u7528\u7684\u6240\u6709\u7D20\u6750\u5747\u5DF2\u83B7\u5F97\u6388\u6743\u3002\n 
    \n  \u6E38\u620F\u540D\uFF1A\u9053\u9B42\n  \u6E38\u620F\u7C7B\u578B\uFF1A2D\u8089\u7C7B\u5438\u8840\u9B3C\n 
    \n  \u5F00\u53D1\u5DE5\u4F5C\u5BA4\uFF1A\u7B2C\u56DB\u9886\u57DF\u521B\u6E38\u793E\n 
    \n  \u5F00\u53D1\u6210\u5458\uFF1A\n  \u7F8E\u672F\u4EBA\u5458\u2014\u2014\u5C0F\u5149\n 
    \u6587\u6848\u7B56\u5212\u2014\u2014\u5C3D\u6570\u6EE1\u5929\u661F\n  \u4E3B\u7B56\u5212\u2014\u2014Superissacboy\n 
    \u526F\u7B56\u5212\u2014\u2014\u89C4\u8303\u7684\u76D1\u63A7\u5BA4\n  \u4E3B\u7A0B\u517C\u9879\u76EE\u8D1F\u8D23\u4EBA\u2014\u2014NFA\u6668\u66E6\n\n\n 
    \u672C\u5DE5\u4F5C\u5BA4\u518D\u6B21\u518D\u6B21\u58F0\u660E\uFF0C\u672C\u6E38\u620F\u6D89\u53CA\u5230\u7684\u6240\u6709\u5267\u60C5\u5185\u5BB9\u7EAF\u5C5E\u865A\u6784\uFF0C\u4E0E\u73B0\u5B9E\u65E0\u5173\uFF0C\u5982\u6709\u96F7\u540C\uFF0C\u7EAF\u5C5E\u5DE7\u5408\uFF0C\u672C\u5DE5\u4F5C\u5BA4\u6240\u6709\u4EBA\u5458\u4E0D\u627F\u62C5\u4EFB\u4F55\u8D23\u4EFB\u3002"
